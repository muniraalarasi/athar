         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Vector floral seamless pattern in arabesque style. Gold and white texture with flowers, leaves, petals, curved shapes. Simple geometric background. Abstract oriental ornament. Repeating luxury design</rdf:li>
            </rdf:Alt>
